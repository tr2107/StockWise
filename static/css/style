/* StockWise styles - plain CSS, no frameworks. Colours are defined once as variables. */
:root {
  --bg: #f4f6fb;
  --surface: #ffffff;
  --text: #1c2536;
  --muted: #667085;
  --border: #e4e8f0;
  --brand: #4f46e5;
  --brand-dark: #4338ca;
  --brand-soft: #eef0ff;
  --sidebar: #111a2e;
  --sidebar-text: #aab4cb;
  --ok: #0f9f6e;       --ok-bg: #e3f7ee;
  --warn: #b7791f;     --warn-bg: #fff4d6;
  --danger: #d92d20;   --danger-bg: #fde8e6;
  --info-bg: #e8f0fe;
  --radius: 12px;
  --shadow: 0 1px 2px rgba(16, 24, 40, .05), 0 1px 3px rgba(16, 24, 40, .06);
}

* { box-sizing: border-box; }
html { font-size: 16px; }
body {
  margin: 0; background: var(--bg); color: var(--text);
  font-family: Inter, "Segoe UI", system-ui, -apple-system, Roboto, Helvetica, Arial, sans-serif;
  line-height: 1.5; -webkit-font-smoothing: antialiased;
}
a { color: var(--brand); text-decoration: none; }
a:hover { text-decoration: underline; }
h1, h2, h3 { margin: 0; line-height: 1.25; }
.icon { width: 18px; height: 18px; flex: none; }
.muted { color: var(--muted); }
.small { font-size: .85rem; }
.pad { padding: 16px 20px; }
[hidden] { display: none !important; }

/* ---------- layout ---------- */
.app { display: flex; min-height: 100vh; }
.sidebar {
  width: 248px; flex: none; background: var(--sidebar); color: var(--sidebar-text);
  display: flex; flex-direction: column; padding: 20px 14px; position: sticky; top: 0; height: 100vh;
}
.brand { display: flex; align-items: center; gap: 12px; color: #fff; padding: 4px 8px 22px; }
.brand:hover { text-decoration: none; }
.brand strong { display: block; font-size: 1.15rem; letter-spacing: .2px; }
.brand small { display: block; color: var(--sidebar-text); font-size: .72rem; }
.brand-mark { width: 38px; height: 38px; border-radius: 10px; background: var(--brand); display: grid; place-items: center; }
.brand-mark .icon { width: 22px; height: 22px; }
.sidebar nav { display: flex; flex-direction: column; gap: 4px; }
.nav-link {
  display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 10px;
  color: var(--sidebar-text); font-weight: 500; font-size: .95rem;
}
.nav-link:hover { background: rgba(255, 255, 255, .06); color: #fff; text-decoration: none; }
.nav-link.active { background: var(--brand); color: #fff; }
.nav-badge { margin-left: auto; background: var(--danger); color: #fff; font-style: normal; font-size: .72rem; font-weight: 700; padding: 1px 8px; border-radius: 999px; }
.sidebar-foot { margin-top: auto; font-size: .75rem; padding: 12px 8px 0; opacity: .7; }

.main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.topbar {
  display: flex; align-items: center; gap: 14px; padding: 16px 28px; background: var(--surface);
  border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 5;
}
.topbar h1 { font-size: 1.35rem; }
.topbar-actions { margin-left: auto; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
.menu-btn { display: none; }
.content { padding: 24px 28px 48px; max-width: 1280px; width: 100%; }

.alert-pill {
  display: inline-flex; align-items: center; gap: 6px; background: var(--warn-bg); color: var(--warn);
  padding: 6px 12px; border-radius: 999px; font-weight: 600; font-size: .85rem;
}
.alert-pill:hover { text-decoration: none; filter: brightness(.97); }

/* ---------- cards & stats ---------- */
.card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); margin-bottom: 20px; overflow: hidden; }
.card-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--border); }
.card-head h2 { font-size: 1.05rem; }
.link { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: .9rem; }
.grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
.grid-2 > .card { margin-bottom: 0; }
.grid-2 { margin-bottom: 20px; }

.stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-bottom: 20px; }
.stats-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.stat { display: flex; align-items: center; gap: 14px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px; box-shadow: var(--shadow); }
.stat-alert { border-color: #f6d58a; background: linear-gradient(180deg, #fffaf0, #fff); }
.stat-icon { width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center; flex: none; }
.stat-icon .icon { width: 22px; height: 22px; }
.c-blue { background: #e0ecff; color: #2563eb; } .c-teal { background: #d9f5ef; color: #0d9488; }
.c-amber { background: var(--warn-bg); color: var(--warn); } .c-violet { background: #ece8ff; color: #6d3fe0; }
.stat-label { display: block; color: var(--muted); font-size: .82rem; font-weight: 500; }
.stat-value { display: block; font-size: 1.65rem; line-height: 1.2; }

/* ---------- tables ---------- */
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: .92rem; }
th { text-align: left; font-size: .75rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); font-weight: 600; background: #fafbfd; padding: 10px 16px; white-space: nowrap; }
td { padding: 12px 16px; border-top: 1px solid var(--border); vertical-align: middle; }
tbody tr:hover { background: #fafbff; }
tfoot td { background: #fafbfd; }
.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
th.num { text-align: right; }
.pos { color: var(--ok); font-weight: 700; } .neg { color: var(--danger); font-weight: 700; }
.sub { color: var(--muted); font-size: .78rem; }
.sub-inline { color: var(--muted); font-weight: 600; }
.actions { white-space: nowrap; text-align: right; }
.actions .inline { display: inline; }
.row-warn { background: #fffdf5; } .row-danger { background: #fff7f6; }
.row-muted { opacity: .6; }
.table-foot { padding: 12px 20px; margin: 0; border-top: 1px solid var(--border); font-size: .85rem; }

.badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: .75rem; font-weight: 700; white-space: nowrap; }
.badge-ok { background: var(--ok-bg); color: var(--ok); }
.badge-warn { background: var(--warn-bg); color: var(--warn); }
.badge-danger { background: var(--danger-bg); color: var(--danger); }
.badge-out { background: #eef0f6; color: #475467; }
.badge-muted { background: #eef0f6; color: var(--muted); }

.all-good { padding: 22px 20px; color: var(--ok); font-weight: 600; background: #f3fbf7; }

/* ---------- feed ---------- */
.feed { list-style: none; margin: 0; padding: 6px 20px 12px; }
.feed li { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--border); }
.feed li:last-child { border-bottom: 0; }
.feed-dot { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; flex: none; }
.feed-dot.in { background: var(--ok-bg); color: var(--ok); } .feed-dot.out { background: var(--danger-bg); color: var(--danger); }
.feed-body a { font-weight: 600; }

.chart-box { padding: 16px 20px 20px; position: relative; height: 320px; }
.chart-fallback { padding: 16px 20px; }

/* ---------- buttons ---------- */
.btn {
  display: inline-flex; align-items: center; gap: 8px; border: 1px solid transparent; border-radius: 10px;
  padding: 9px 16px; font: inherit; font-weight: 600; font-size: .9rem; cursor: pointer; background: none; color: var(--text);
}
.btn:hover { text-decoration: none; }
.btn-primary { background: var(--brand); color: #fff; } .btn-primary:hover { background: var(--brand-dark); }
.btn-ghost { background: var(--surface); border-color: var(--border); } .btn-ghost:hover { background: #f5f7fb; }
.btn-danger-ghost { color: var(--danger); border-color: var(--border); background: var(--surface); } .btn-danger-ghost:hover { background: var(--danger-bg); }
.btn-sm { padding: 5px 11px; font-size: .8rem; border-radius: 8px; }
.icon-btn { background: none; border: 0; padding: 6px; cursor: pointer; color: var(--text); border-radius: 8px; }
:focus-visible { outline: 3px solid #a5b4fc; outline-offset: 2px; }

/* ---------- forms ---------- */
.filters { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; padding: 16px 20px; border-bottom: 1px solid var(--border); }
.card > .filters:only-child { border-bottom: 0; }
.filters input[type=search] { flex: 1 1 220px; min-width: 180px; }
input, select, textarea {
  font: inherit; color: var(--text); background: #fff; border: 1px solid #cfd5e2; border-radius: 10px; padding: 9px 12px; width: 100%;
}
.filters input, .filters select { width: auto; }
input:focus, select:focus, textarea:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px #e0e3ff; }
input:disabled { background: #f2f4f8; color: var(--muted); }
.check, .inline-label { display: inline-flex; align-items: center; gap: 6px; font-size: .9rem; color: var(--muted); }
.check input { width: auto; }
.inline-label input { width: auto; }

.form-card { padding: 24px; max-width: 880px; }
.lead { margin: 0 0 20px; color: var(--muted); }
.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 20px; }
.field { display: flex; flex-direction: column; gap: 6px; }
.field.full { grid-column: 1 / -1; }
label { font-weight: 600; font-size: .88rem; }
.req { color: var(--danger); }
.hint { color: var(--muted); font-size: .8rem; }
.error-text { color: var(--danger); font-size: .82rem; font-weight: 600; }
.has-error input, .has-error select, .has-error textarea { border-color: var(--danger); background: #fffafa; }
.form-actions { display: flex; gap: 10px; margin-top: 26px; }

/* ---------- flash messages ---------- */
.flashes { margin-bottom: 16px; display: grid; gap: 10px; }
.flash { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 12px 16px; border-radius: 10px; font-weight: 500; border: 1px solid; margin-bottom: 14px; }
.flashes .flash { margin-bottom: 0; }
.flash-success { background: var(--ok-bg); color: #0b6b4a; border-color: #b6e8d2; }
.flash-error { background: var(--danger-bg); color: #9c1d14; border-color: #f7c1bc; }
.flash-warning { background: var(--warn-bg); color: #7a4d0b; border-color: #f2d58c; }
.flash-close { background: none; border: 0; font-size: 1.3rem; line-height: 1; cursor: pointer; color: inherit; opacity: .6; }

/* ---------- details ---------- */
.details { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px 20px; margin: 0; padding: 20px; }
.details dt { color: var(--muted); font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; }
.details dd { margin: 2px 0 0; font-weight: 600; }
.details .full { grid-column: 1 / -1; }

/* ---------- empty state ---------- */
.empty { text-align: center; padding: 44px 20px; }
.empty-art { width: 64px; height: 64px; margin: 0 auto 14px; border-radius: 18px; background: var(--brand-soft); color: var(--brand); display: grid; place-items: center; }
.empty-art .icon { width: 30px; height: 30px; }
.empty h3 { font-size: 1.1rem; margin-bottom: 6px; }
.empty p { color: var(--muted); max-width: 440px; margin: 0 auto 18px; }

/* ---------- responsive ---------- */
@media (max-width: 1100px) {
  .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .details { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grid-2 { grid-template-columns: 1fr; }
}
@media (max-width: 860px) {
  .sidebar { position: fixed; left: 0; top: 0; z-index: 20; transform: translateX(-100%); transition: transform .2s ease; }
  .sidebar.open { transform: none; box-shadow: 0 0 40px rgba(0, 0, 0, .35); }
  .menu-btn { display: inline-flex; }
  .topbar { padding: 12px 16px; }
  .topbar h1 { font-size: 1.15rem; }
  .content { padding: 16px 14px 40px; }
  .form-grid { grid-template-columns: 1fr; }
  .form-card { padding: 18px; }
}
@media (max-width: 560px) {
  .stats, .stats-3 { grid-template-columns: 1fr; }
  .details { grid-template-columns: 1fr; }
  .topbar-actions .btn { padding: 7px 10px; }
  .filters > * { flex: 1 1 100%; }
  .filters .btn { flex: 1 1 auto; justify-content: center; }
}

